<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PostPilot</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>postpilot</ToolCommandName>
    <PackageId>PostPilot</PackageId>
    <Version>0.1.0</Version>
    <Description>Upload videos to TikTok through the official Content Posting API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

</Project>
